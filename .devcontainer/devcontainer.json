{
    "name": "manyfold Development Container",
    "image": "ghcr.io/rails/devcontainer/images/ruby:3.4.9",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        },
        "ghcr.io/rails/devcontainer/features/activestorage": {},
        "ghcr.io/itsmechlark/features/redis-server:1": {}
    },
    "initializeCommand": "mkdir -p ${localEnv:HOME}/manyfold-data",
    "mounts": [
      "source=${localEnv:HOME}/manyfold-data,target=/libraries,type=bind,consistency=cached"
   ],
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "redis-server --daemonize yes && bash ./bin/dev",
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "Shopify.ruby-lsp"
            ]
        }
    },
    "containerEnv": {
        "SHELL": "/bin/bash",
        "RAILS_ENV": "development",
        "NODE_ENV": "development"
    },
    "forwardPorts": [
        3214
    ],
    "portsAttributes": {
        "3214": {
            "label": "Rails Server",
            "onAutoForward": "notify"
        }
    }
}
