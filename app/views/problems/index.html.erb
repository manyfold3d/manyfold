<%= PageTitle title: @duplicate_list ? t(".merge_title") : Problem.model_name.human(count: 100), heading: false %>

<%= render "filters" %>

<% if @counts_by_category.present? %>
  <div class="flex flex-wrap gap-2 mb-4">
    <% @counts_by_category.sort_by { |cat, _| cat.to_s }.each do |cat, count| %>
      <% active = params[:category].to_a.include?(cat.to_s) %>
      <%= link_to "#{t("problems.categories.%{cat}" % {cat: cat})} (#{count})", problems_path(request.query_parameters.merge(category: [cat])), class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm no-underline focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:outline-none #{active ? "bg-primary-600 text-white dark:bg-primary-500 dark:text-white" : "bg-surface dark:bg-secondary-800 text-secondary-800 dark:text-secondary-100 border border-secondary-200 dark:border-secondary-600 hover:border-primary-400"}" %>
    <% end %>
  </div>
<% end %>

<% if @problems.empty? %>
  <%= render "application/empty_state", message: t(".no_problems"), icon: "check-circle" do %>
    <p><%= link_to Model.model_name.human(count: 100), models_path, class: "#{primary_button_class} no-underline" %></p>
  <% end %>
<% else %>
  <% bulk_resolve_class = [Components::BaseButton::BASE_CLASSES, (@duplicate_list ? Components::BaseButton::VARIANT_CLASSES["outline-danger"] : Components::BaseButton::VARIANT_CLASSES["danger"])].join(" ") %>
  <div class="flex flex-col gap-6" data-controller="problem-list-filter">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-4">
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-secondary-50 m-0">
          <%= @duplicate_list ? t(".merge_title") : Problem.model_name.human(count: 100) %>
        </h1>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-semibold text-primary-600 dark:text-primary-400 bg-secondary-100 dark:bg-secondary-800 border border-secondary-200 dark:border-secondary-600">
          <%= t(".groups_found", count: @problems.total_count) %>
        </span>
      </div>
      <% if @recoverable_bytes.to_i.positive? %>
        <p class="text-sm text-secondary-500 dark:text-secondary-400 m-0">
          <%= t(".space_recoverable") %>
          <span class="font-semibold text-secondary-900 dark:text-secondary-100"><%= number_to_human_size(@recoverable_bytes) %></span>
        </p>
      <% end %>
    </div>

    <p class="text-sm text-secondary-500 dark:text-secondary-400 m-0">
      <%= @duplicate_list ? t(".merge_explainer") : t(".explainer") %>
    </p>

    <%= form_with url: resolve_problems_path(format: :turbo_stream), method: :post, class: "mb-0", data: {controller: "bulk-edit collapse", action: "change->bulk-edit#handleCheckboxChange"} do |form| %>
      <div class="flex flex-wrap items-center justify-between gap-3 p-4 mb-3 rounded-lg border border-secondary-200 dark:border-secondary-600 bg-secondary-50 dark:bg-secondary-800/50">
        <div class="flex flex-wrap items-center gap-4">
          <label class="inline-flex items-center gap-2 text-sm text-secondary-800 dark:text-secondary-100 cursor-pointer">
            <input type="checkbox" aria-label="<%= translate ".select_all" %>" value="0" name="bulk-select-all" class="rounded border-secondary-300 text-primary-600 focus:ring-primary-500 h-4 w-4">
            <%= t(".select_all") %>
          </label>
          <span class="hidden sm:block w-px h-4 bg-secondary-300 dark:bg-secondary-600" aria-hidden="true"></span>
          <div class="flex flex-wrap gap-2">
            <%= form.submit(@duplicate_list ? translate(".bulk_delete") : translate(".bulk_resolve"), name: "resolve", class: bulk_resolve_class, data: {confirm: translate(".bulk_confirm")}) %>
            <%= form.submit translate(".bulk_ignore"), name: "ignore", class: secondary_button_class %>
          </div>
        </div>
        <label class="relative w-full sm:w-64">
          <span class="absolute inset-y-0 left-3 flex items-center text-secondary-400 pointer-events-none">
            <%= Icon(icon: "search", label: t(".filter_names")) %>
          </span>
          <input type="search"
            autocomplete="off"
            data-problem-list-filter-target="query"
            data-action="input->problem-list-filter#filter"
            placeholder="<%= t(".filter_names") %>"
            class="w-full rounded-md border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-900 pl-9 pr-3 py-2 text-sm text-secondary-800 dark:text-secondary-100 placeholder:text-secondary-400 focus:ring-2 focus:ring-primary-500">
        </label>
      </div>

      <div class="flex flex-col gap-2">
        <% @problems.each do |problem| %>
          <% next unless problem.problematic %>
          <%= render Components::ProblemRow.new(problem: problem, user: current_user) do %>
            <%= form.check_box "problems[#{problem.to_param}]", data: {resolution_strategy: problem.resolution_strategy, bulk_item: problem.to_param}, "aria-label": translate(".select"), class: "rounded border-secondary-300 text-primary-600 focus:ring-primary-500 h-[18px] w-[18px] shrink-0" %>
          <% end %>
        <% end %>
        <p class="hidden text-sm text-secondary-500 dark:text-secondary-400 m-0 py-6 text-center" data-problem-list-filter-target="empty">
          <%= t(".no_filter_matches") %>
        </p>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-secondary-500 dark:text-secondary-400 m-0">
        <%= t(".showing", from: @problems.offset_value + 1, to: @problems.offset_value + @problems.length, total: @problems.total_count) %>
      </p>
      <%= paginate @problems %>
    </div>
  </div>
<% end %>
