<%= PageTitle title: t("model_files.edit_content.title"), breadcrumbs: {
      Model.model_name.human(count: 100) => models_path,
      @file.model.name => model_path(@file.model),
      @file.name => model_model_file_path(@file.model, @file)
    } %>

<%= form_tag model_model_file_raw_path(@file.model, @file.filename), method: :put, class: "container-md" do %>
  <%= text_area_tag :body, @file.attachment.read, class: "form-control" %>

  <div class="form-save-button">
    <%= submit_tag %>
  </div>
<% end %>
