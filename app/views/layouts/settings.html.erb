
<% if policy(:settings).index? %>
  <%= PageTitle title: t(".site_settings_title") %>
<% elsif policy(:user).index? %>
  <%= PageTitle title: t(".moderation_settings_title") %>
<% end %>
<% if Rails.cache.read("restart_required") %>
  <div class="alert alert-danger">
    <%= t(".restart_required") %>
  </div>
<% end %>
<div class="row mt-2 flex-nowrap">
  <div class="col col-auto border-end" id="sidebar">
    <ul class="nav flex-column">
      <% if policy(:settings).index? %>
        <%= side_menu_link t(".organization"), settings_path, icon: "folder-fill" %>
        <%= side_menu_link t(".libraries"), settings_libraries_path, icon: "boxes" %>
        <%= side_menu_link t("settings.derivatives.heading"), derivatives_settings_path, icon: "box-arrow-up-right" %>
        <%= side_menu_link t(".appearance"), appearance_settings_path, icon: "palette-fill" %>
        <%= side_menu_link t("settings.analysis.heading"), analysis_settings_path, icon: "flask-fill" %>
        <%= side_menu_link t("settings.multiuser.heading"), multiuser_settings_path, icon: "people-fill" %>
        <%= side_menu_link t("views.plugins.index.title"), settings_plugins_path, icon: "puzzle-fill" %>
      <% end %>
    </ul>
    <% if SiteSettings.multiuser_enabled? %>
      <hr>
      <h5><%= t(".moderation_heading") %></h5>
      <ul class="nav flex-column">
        <%= side_menu_link t("settings.users.index.title"), settings_users_path, icon: "person-fill" %>
        <%= side_menu_link t("settings.reports.index.title"), settings_reports_path, icon: "flag-fill" %>
        <%= side_menu_link t("settings.domain_blocks.index.title"), settings_domain_blocks_path, icon: "sign-stop-fill" if SiteSettings.federation_enabled? %>
      </ul>
    <% end %>
    <% if policy(:settings).index? && current_user&.is_administrator? %>
      <hr>
      <h5><%= t(".search_heading") %></h5>
      <ul class="nav flex-column">
        <%= side_menu_link t("settings.discovery.heading"), discovery_settings_path, icon: "search" %>
        <%= side_menu_link t("fasp_client.providers.index.heading"), fasp_client.providers_path, icon: "hdd-network-fill" if SiteSettings.federation_enabled? %>
      </ul>
    <% end %>
    <% if policy(:settings).index? and not SiteSettings.demo_mode_enabled? %>
      <hr>
      <h5><%= t(".integrations_heading") %></h5>
      <ul class="nav flex-column">
        <%= side_menu_link t("views.print_hosts.index.title"), print_hosts_path, icon: "printer-fill" %>
        <%= side_menu_link t("doorkeeper_applications.index.title"), doorkeeper_applications_path, icon: "key-fill" %>
        <%= side_menu_link t("settings.integrations.heading"), integrations_settings_path, icon: "diagram-3-fill" %>
      </ul>
    <% end %>
    <% if policy(:settings).index? and not SiteSettings.demo_mode_enabled? %>
      <hr>
      <h5><%= t(".tools_heading") %></h5>
      <ul class="nav flex-column">
        <%= side_menu_link t("settings.reporting.heading"), reporting_settings_path, icon: "diagram-3-fill" %>
        <%= side_menu_link t(".performance"), rails_performance_path, icon: "cpu-fill" unless Rails.env.test? %>
        <%= side_menu_link t(".sidekiq"), sidekiq_web_path, icon: "activity" %>
        <%= side_menu_link t(".pghero"), pg_hero_path, icon: "database-fill" if DatabaseDetector.is_postgres? %>
      </ul>
    <% end %>
  </div>
  <div class="col col-auto" id="content">
    <%= yield %>
  </div>
</div>

<% parent_layout "application" %>
